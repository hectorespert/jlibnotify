<?xml version="1.0"?>
<!DOCTYPE suppressions PUBLIC
        "-//Checkstyle//DTD SuppressionFilter Configuration 1.2//EN"
        "https://checkstyle.org/dtds/suppressions_1_2.dtd">

<!--
    Checks of sun_checks.xml that this project deliberately does not follow.

    Everything suppressed here is a decision the project already took, not a
    backlog: the entries are meant to stay. Anything the report shows is
    therefore something to fix.
-->
<suppressions>

    <!-- The names of the JNA binding mirror the C symbols of libnotify one for
         one (notify_init, app_name, ret_spec_version). Renaming them to camel
         case would break the mapping, so the naming rules do not apply there.
         Scoped to that single file on purpose. -->
    <suppress files="NativeLibnotify\.java|NativeLibNotifyMock\.java" checks="MethodName|ParameterName"/>

    <!-- sun_checks limits lines to 80 columns. This project never adopted that
         limit and reads at up to 143; adopting it would rewrap most of the
         code for no benefit. -->
    <suppress files="." checks="LineLength"/>

    <!-- Parameters are not declared final anywhere in this project. -->
    <suppress files="." checks="FinalParameters"/>

    <!-- DesignForExtension wants every public method of a non-final class to
         be abstract, final or empty. The Default* classes are plain
         implementations of the public interfaces, which is the intended
         design. -->
    <suppress files="." checks="DesignForExtension"/>

    <!-- Javadoc on private fields, on top of the javadoc that doclint already
         enforces for the API, adds noise rather than information. -->
    <suppress files="." checks="JavadocVariable"/>

    <!-- Constructor parameters share the name of the field they initialise,
         which is the constructor injection pattern used throughout. -->
    <suppress files="." checks="HiddenField"/>

    <!-- One known TODO, in DefaultJLibnotifyNotification.show(). It is tracked
         in the code on purpose; the check would report it on every build. -->
    <suppress files="." checks="TodoComment"/>

    <!-- Test sources. The tests carry no javadoc and none is wanted: they are
         read as code, and their names already say what they cover. The magic
         numbers are the timeouts and delays the integration tests wait for. -->
    <suppress files="src[\\/]test[\\/]" checks="JavadocPackage|MissingJavadocMethod|MagicNumber"/>

</suppressions>
