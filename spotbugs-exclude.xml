<!--
    SpotBugs findings that do not apply to a native binding.

    Only what is inherent to binding a C library belongs here. Findings that
    describe real debt are left visible in the report on purpose.
-->
<FindBugsFilter>

    <!-- Holding the pointer that notify_notification_new returned is the whole
         job of this class. There is nothing to copy defensively: the pointer is
         the native notification, owned by libnotify, and a copy would not refer
         to it. -->
    <Match>
        <Class name="es.blackleg.jlibnotify.core.DefaultJLibnotifyNotification"/>
        <Bug pattern="EI_EXPOSE_REP2"/>
    </Match>

</FindBugsFilter>
